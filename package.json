{
  "name": "editflow",
  "productName": "EditFlow",
  "version": "0.1.51",
  "description": "Gestao de producao para equipes de edicao.",
  "author": "EditFlow",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "prepackage": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File build/compile-update-helper.ps1",
    "package": "electron-forge package",
    "make": "npm run package && electron-builder --win nsis --prepackaged out/EditFlow-win32-x64 --publish never",
    "release": "npm run package && electron-builder --win nsis --prepackaged out/EditFlow-win32-x64 --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.editflow.desktop",
    "productName": "EditFlow",
    "protocols": [
      {
        "name": "EditFlow Password Recovery",
        "schemes": [
          "editflow"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Jhoonnz",
      "repo": "EditFlow",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/editflow-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/editflow-icon.ico",
      "uninstallerIcon": "build/editflow-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EditFlow",
      "uninstallDisplayName": "EditFlow",
      "installerLanguages": [
        "pt_BR"
      ],
      "artifactName": "EditFlow-Setup-${version}.${ext}"
    }
  }
}
